# Copy to .env and adjust. Never commit the real .env file.
PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:password@localhost:5432/task_manager
# Used only by `npm test` integration tests. Must point at a separate database
# whose name contains "test" - the tests delete all rows between runs.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/task_manager_test

REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=60

# Use a long random value, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
# Max login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=20
LOG_LEVEL=info
